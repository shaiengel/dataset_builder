{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HF: upload evaluation dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "dataset_builder.infrastructure.hf_dataset_manager",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "portal"
            },
            "args": [
                "--dataset-path", "output/evaluation-il",
                "--repo-id", "portal-daf-yomi/portal-daf-yomi-evaluation-il",
                "--no-split",
                "--pretty-name", "Portal Daf Yomi Evaluation - Israeli Accent",
                "--template-path", "evaluation_card_template.md"
            ]
        },
        {
            "name": "HF: load, split & upload dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "dataset_builder.infrastructure.hf_dataset_manager",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "portal"
            },
            "args": [
                "--repo-id", "portal-daf-yomi/portal-daf-yomi-whisper-training",
                "--test-size", "0.1"
            ]
        },
        {
            "name": "HF: append to training dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "dataset_builder.infrastructure.hf_dataset_manager",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "portal"
            },
            "args": [
                "--append",
                "--repo-id", "portal-daf-yomi/portal-daf-yomi-whisper-training",
                "--test-size", "0.1"
            ]
        },
        {
            "name": "Python: main.py (batch 500)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "portal"
            },
            "args": ["--limit", "500"]
        },
        {
            "name": "Python: eval_main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/eval_main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "portal"
            }
        },
        {
            "name": "Python: main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "portal"
            }
        }
    ]
}
